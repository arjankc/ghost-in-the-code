# Local Ollama runtime (bound to localhost by the app)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model: ~986MB, Apache-2.0, fits limited VRAM (e.g. GTX 1050 Ti)
# Alternatives: qwen2.5:3b (~1.9GB, Qwen Research License), gemma3:1b
OLLAMA_MODEL=qwen2.5:1.5b

# Inference tuning
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT_MS=120000

# App server (localhost only)
PORT=8787
HOST=127.0.0.1
